  location     String?
  latitude     Float?
  longitude    Float?
  filter       String?
  effects      Json?
  isFavorite   Boolean           @default(false) @map("is_favorite")
  isFeatured   Boolean           @default(false) @map("is_featured")
  privacy      GalleryPrivacy?   @map("privacy")
  createdAt    DateTime          @default(now()) @map("created_at")
